# Copy this file to `.env` and fill in the keys for the providers you use.
# Unused providers can be left blank.

# Google AI Studio / Gemini (current default)
GEMINI_API_KEY =

# OpenAI-compatible providers
OPENROUTER_API_KEY =
DEEPSEEK_API_KEY =
